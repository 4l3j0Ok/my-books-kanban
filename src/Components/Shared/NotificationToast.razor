@* Toast accesible. *@
@implements IDisposable
@inject KanbanState State

@if (!string.IsNullOrEmpty(State.Notification))
{
    <div class="@($"fixed bottom-4 right-4 z-50 flex max-w-[calc(100%-2rem)] items-center gap-2 rounded-sm border-l-2 {BorderClass} bg-[var(--surface)] p-3 font-body text-sm text-[var(--ink)] shadow-md")" role="status" aria-live="polite">
        <span>@State.Notification</span>
        <button type="button" class="ms-2 rounded-sm p-1 font-mono text-xs text-[var(--muted)] hover:bg-[var(--surface-2)]" aria-label="Cerrar notificación"
                @onclick="() => State.ClearNotification()">✕</button>
    </div>
}

@code {
    private string BorderClass => State.NotificationKind switch
    {
        NotificationKind.Success => "border-l-[var(--success)]",
        NotificationKind.Error => "border-l-[var(--danger)]",
        _ => "border-l-[var(--brass)]"
    };

    protected override void OnInitialized() => State.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnChanged;
}
