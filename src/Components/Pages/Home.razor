@page "/"
@inject IBookService BookService
@inject ICategoryService CategoryService
@inject ICoverStorageService CoverStorage
@inject KanbanState State
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Tablero · My Books Kanban</PageTitle>

<section class="library page-centered" aria-label="Tu biblioteca">
    <header class="library-header">
        <h1 class="library-title">Tu biblioteca</h1>
        <p class="library-stats">
            <span><strong>@TotalBooks</strong> libros</span>
            <span class="library-stats-dot" aria-hidden="true">·</span>
            <span>arrastra un lomo entre estantes para reubicarlo</span>
        </p>
    </header>

    <SearchAndFilters class="library-index" Term="@State.SearchTerm" CategoryId="@State.CategoryId"
                      Status="@State.Status" Categories="categories" OnApply="ApplyFilters" OnClear="ClearFilters" />

    @if (State.IsLoading)
    {
        <p class="library-loading" aria-live="polite">Cargando tablero…</p>
    }

    <KanbanBoard Board="board" OnOpenBook="OpenBook" OnDropBook="DropBook" />
</section>

<div class="drawer @DrawerClass" role="dialog" aria-modal="true" aria-labelledby="drawer-title"
     aria-hidden="@(SelectedBook is null)">
    <div class="drawer-backdrop" @onclick="CloseBook"></div>
    <div class="drawer-panel @PanelAnimationClass">
        <div class="drawer-handle" aria-hidden="true"></div>
        <BookCoverDetail Book="SelectedBook" FormModel="FormModel" Categories="categories" OnClose="CloseBook"
                         OnStatusChange="ChangeStatus" OnComplete="CompleteBook"
        OnDelete="ConfirmDelete" OnSave="SaveBook" OnProgressChange="ChangeProgress" />
    </div>
</div>

@code {
    private BoardViewModel board = new();
    private List<CategoryListItem> categories = new();
    private BookSummary? SelectedBook;
    private BookFormModel? FormModel;
    private string DrawerClass => SelectedBook is null ? "is-closed" : "is-open";

    private string PanelAnimationClass => SelectedBook is null ? string.Empty : "drawer-panel-turn";

    private int TotalBooks => board.Columns.Values.Sum(c => c.Count);

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        State.DataChanged += OnDataChanged;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        State.SetLoading(true);
        try
        {
            categories = (await CategoryService.ListAsync()).ToList();
            board = await BookService.GetBoardAsync(State.SearchTerm, State.CategoryId, State.Status);
        }
        finally
        {
            State.SetLoading(false);
        }
    }

    private async Task ApplyFilters(SearchAndFilters.FilterPayload payload)
    {
        State.SetSearch(payload.Term);
        State.SetCategory(payload.CategoryId);
        State.SetStatus(payload.Status);
        await ReloadAsync();
    }

    private async Task ClearFilters()
    {
        State.ClearFilters();
        await ReloadAsync();
    }

    private async Task OpenBook(int id)
    {
        var selectedBook = await BookService.GetSummaryAsync(id);
        var formModel = selectedBook is null
            ? null
            : await BookService.GetForEditAsync(id);

        OpenPreparedBook(id, selectedBook, formModel);
    }

    private void OpenPreparedBook(int id, BookSummary? selectedBook, BookFormModel? formModel)
    {
        State.OpenBook(id);
        SelectedBook = selectedBook;
        FormModel = formModel;
    }

    private async Task CloseBook()
    {
        CloseBookCore();
    }

    private void CloseBookCore()
    {
        SelectedBook = null;
        FormModel = null;
        State.CloseBook();
    }

    private async Task SaveBook(BookFormModel model)
    {
        try
        {
            if (model.CoverUpload is not null)
                model.CoverPath = await CoverStorage.SaveAsync(model.CoverUpload, model.CoverPath);

            var bookId = model.Id ?? 0;
            if (bookId == 0) bookId = await BookService.CreateAsync(model);
            else await BookService.UpdateAsync(model);

            State.NotifySuccess("Libro guardado.");
            await ReloadAsync();
            SelectedBook = await BookService.GetSummaryAsync(bookId);
        }
        catch (Exception ex)
        {
            State.NotifyError(ex.Message);
        }
    }

    /// <summary>
    /// El lomo del tablero no muestra el progreso, así que basta con refrescar la
    /// ficha abierta: evitamos recargar el tablero y que el cajón parpadee.
    /// </summary>
    private async Task ChangeProgress(int page)
    {
        if (SelectedBook is null) return;

        try
        {
            var updated = await BookService.UpdateProgressAsync(SelectedBook.Id, page);
            if (updated is null) return;

            SelectedBook = updated;
            if (FormModel is not null) FormModel.CurrentPage = updated.CurrentPage;
        }
        catch (Exception ex)
        {
            State.NotifyError(ex.Message);
        }
    }

    private async Task CompleteBook()
    {
        if (SelectedBook is null) return;

        try
        {
            var id = SelectedBook.Id;
            var updated = await BookService.CompleteAsync(id);
            if (updated is null) return;

            await ReloadAsync();
            SelectedBook = updated;
            FormModel = await BookService.GetForEditAsync(id);
            State.NotifySuccess("Libro completado.");
        }
        catch (Exception ex)
        {
            State.NotifyError(ex.Message);
        }
    }

    private async Task ChangeStatus(ReadingStatus status)
    {
        if (SelectedBook is null) return;

        try
        {
            var id = SelectedBook.Id;
            await BookService.MoveAsync(id, status, null);
            await ReloadAsync();
            SelectedBook = await BookService.GetSummaryAsync(id);
            if (FormModel is not null) FormModel.ReadingStatus = status;
        }
        catch (Exception ex)
        {
            State.NotifyError(ex.Message);
        }
    }

    private void ConfirmDelete(int id)
    {
        State.NotifyInfo($"Confirmación de borrado del libro {id} aún no implementada en Home; use la página de detalle.");
    }

    private async Task DropBook((int BookId, ReadingStatus Target, int TargetIndex) args)
    {
        try
        {
            await BookService.MoveAsync(args.BookId, args.Target, args.TargetIndex);
            await ReloadAsync();
            State.NotifySuccess("Libro reubicado.");
        }
        catch (Exception ex)
        {
            State.NotifyError(ex.Message);
        }
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void OnDataChanged() => InvokeAsync(ReloadAsync);

    public void Dispose()
    {
        State.Changed -= OnStateChanged;
        State.DataChanged -= OnDataChanged;
    }
}
