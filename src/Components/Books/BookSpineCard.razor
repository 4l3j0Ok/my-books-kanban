@using MyBooksKanban.Application.Colors
@{
    // Si el libro tiene portada, el lomo hereda su color dominante; si no, se
    // deriva un color estable del nombre de la categoría.
    var (accent, ink, inkHalo) = SpinePalette.Resolve(Book.SpineColor, Book.CategoryName);
    var stateClass = IsDragging ? "is-dragging" : null;
}

<article class="@($"spine-card {stateClass}") flex items-stretch overflow-hidden rounded-lg cursor-grab select-none"
         style="--spine-accent: @accent; --spine-ink: @ink; --spine-ink-halo: @inkHalo;"
         role="listitem"
         tabindex="0"
         data-book-id="@Book.Id"
         draggable="true"
         @onclick="HandleClick"
         @onkeydown="HandleKey"
         @ondragstart="HandleDragStart"
         @ondragend="HandleDragEnd">
    <div class="spine-face relative isolate flex min-w-0 flex-1 flex-col justify-center gap-0.5 border-l-[3px] border-black/20 bg-[--spine-accent] px-3 py-2 text-left text-[--spine-ink]">
        <span class="relative z-10 truncate font-display text-sm font-semibold leading-tight tracking-tight" title="@Book.Title">@Book.Title</span>
        <span class="relative z-10 truncate font-body text-2xs leading-snug opacity-80" title="@Book.Author">@Book.Author</span>
        @if (Book.Rating is { } rating)
        {
            <span class="relative z-10 font-mono text-2xs tracking-wider opacity-70" aria-label="@($"Calificación {rating} de 5")">
                @rating/5
            </span>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public BookSummary Book { get; set; } = default!;

    [Parameter] public bool IsDragging { get; set; }

    [Parameter] public EventCallback<int> OnOpen { get; set; }
    [Parameter] public EventCallback<int> OnDragStart { get; set; }
    [Parameter] public EventCallback OnDragEnd { get; set; }

    private Task HandleClick() => OnOpen.InvokeAsync(Book.Id);

    private Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
        {
            return OnOpen.InvokeAsync(Book.Id);
        }
        return Task.CompletedTask;
    }

    private Task HandleDragStart(DragEventArgs e) => OnDragStart.InvokeAsync(Book.Id);
    private Task HandleDragEnd(DragEventArgs e) => OnDragEnd.InvokeAsync();
}
