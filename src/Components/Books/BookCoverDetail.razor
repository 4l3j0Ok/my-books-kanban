@* Panel de detalle con apariencia de ficha de catálogo. *@
@using MyBooksKanban.Application.Colors

<article class="catalogue @(HasCover ? "has-cover" : null)" style="@ArticleStyle"
         role="complementary" aria-label="Detalle del libro" id="@($"book-detail-{Book?.Id}")">
    @if (Book is null)
    {
        <div class="catalogue-empty">
            <EmptyState Title="Selecciona un libro" Description="Haz clic en un lomo del tablero para ver su detalle." />
        </div>
    }
    else
    {
        <header class="catalogue-header">
            <span class="catalogue-eyebrow">Ficha de catálogo</span>
            <button type="button" class="catalogue-close" aria-label="Cerrar detalle"
                    @onclick="() => OnClose.InvokeAsync()">X</button>
        </header>

        <div class="catalogue-title-block @PanelClass">
            <h2 id="drawer-title" class="catalogue-title">@Book.Title</h2>
            <p class="catalogue-byline">de <span>@Book.Author</span></p>
        </div>

        <div class="catalogue-rule" aria-hidden="true"></div>

        <div class="catalogue-body">
            @if (!HasCover)
            {
                <figure class="catalogue-cover">
                    <div class="catalogue-cover-placeholder" aria-hidden="true">Sin portada</div>
                </figure>
            }

            @if (Editing)
            {
                <div class="catalogue-edit @PanelClass">
                    <BookForm Model="FormModel!" Categories="Categories" OnSubmit="HandleSave"
                        OnCancel="() => Editing = false" />
                </div>
            }
            else
            {
                <dl class="catalogue-fields @PanelClass">
                    <div class="catalogue-field">
                        <dt>Categoría</dt>
                        <dd>@Book.CategoryName</dd>
                    </div>
                    <div class="catalogue-field">
                        <dt>Estado</dt>
                        <dd>
                            <select class="catalogue-select" aria-label="Estado de lectura"
                                    value="@Book.Status" @onchange="ChangeStatus">
                                @foreach (var status in Enum.GetValues<ReadingStatus>())
                                {
                                    <option value="@status" selected="@(status == Book.Status)">@StatusLabel(status)</option>
                                }
                            </select>
                        </dd>
                    </div>
                    @if (Book.PageCount is { } totalPages)
                    {
                        <div class="catalogue-field">
                            <dt>Páginas</dt>
                            <dd>@totalPages</dd>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Book.Isbn))
                    {
                        <div class="catalogue-field">
                            <dt>ISBN</dt>
                            <dd class="catalogue-mono">@Book.Isbn</dd>
                        </div>
                    }
                    @if (Book.StartedAt is { } started)
                    {
                        <div class="catalogue-field">
                            <dt>Inicio</dt>
                            <dd>@started.ToString("dd/MM/yyyy")</dd>
                        </div>
                    }
                    @if (Book.FinishedAt is { } finished)
                    {
                        <div class="catalogue-field">
                            <dt>Fin</dt>
                            <dd>@finished.ToString("dd/MM/yyyy")</dd>
                        </div>
                    }
                    <div class="catalogue-field catalogue-field-progress">
                        <dt>Progreso</dt>
                        <dd class="catalogue-progress">
                            @if (Book.PageCount is { } pages)
                            {
                                <span class="catalogue-progress-track" role="progressbar"
                                      aria-valuemin="0" aria-valuemax="@pages" aria-valuenow="@CurrentPage"
                                      aria-label="Páginas leídas">
                                    <span class="catalogue-progress-bar" style="width:@ProgressPct(pages)%"></span>
                                </span>
                            }
                            <div class="catalogue-pager">
                                <button type="button" class="catalogue-pager-step"
                                        aria-label="Retroceder una página" disabled="@(!CanRewind)"
                                        @onclick="() => StepPage(-1)">&#8722;</button>
                                <span class="catalogue-pager-figure">
                                    @* La clave fuerza un input nuevo en cada commit: si el
                                       servidor recorta el número escrito, el DOM se sincroniza. *@
                                    <input @key="_pageInputEpoch" type="number" class="catalogue-pager-input"
                                           inputmode="numeric" min="0" max="@MaxPage"
                                           aria-label="@PageInputLabel" value="@CurrentPage"
                                           @onchange="SetPage" />
                                    <span class="catalogue-pager-total" aria-hidden="true">@TotalLabel</span>
                                </span>
                                <button type="button" class="catalogue-pager-step"
                                        aria-label="Avanzar una página" disabled="@(!CanAdvance)"
                                        @onclick="() => StepPage(1)">+</button>
                            </div>
                            @if (Book.Status != ReadingStatus.Read)
                            {
                                <button type="button" class="btn btn-primary catalogue-complete"
                                        @onclick="AskComplete">Marcar como completado</button>
                            }
                        </dd>
                    </div>
                    @if (Book.Rating is { } rating)
                    {
                        <div class="catalogue-field">
                            <dt>Calificación</dt>
                            <dd class="catalogue-rating">
                                @* Agregamos ★ multiplicado por rating *@
                                @for (var i = 0; i < rating; i++)
                                {
                                    <span class="catalogue-rating-star" aria-hidden="true">★</span>
                                }
                            </dd>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Book.Description))
                    {
                        <div class="catalogue-field catalogue-field-stacked">
                            <dt>Descripción</dt>
                            <dd class="catalogue-description">@Book.Description</dd>
                        </div>
                    }
                </dl>

                <div class="catalogue-actions @PanelClass">
                    <button class="btn btn-primary" type="button" @onclick="() => Editing = true">Editar</button>
                    <button class="btn btn-danger" type="button"
                            @onclick="() => OnDelete.InvokeAsync(Book.Id)">Eliminar</button>
                </div>
            }
        </div>
    }
    <ConfirmDialog @ref="_confirm" />
</article>

@code {
    [Parameter] public BookSummary? Book { get; set; }
    [Parameter] public BookFormModel? FormModel { get; set; }
    [Parameter] public IReadOnlyList<CategoryListItem> Categories { get; set; } = Array.Empty<CategoryListItem>();

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }
    [Parameter] public EventCallback<BookFormModel> OnSave { get; set; }

    /// <summary>Página absoluta elegida por el lector. El padre persiste y devuelve el libro.</summary>
    [Parameter] public EventCallback<int> OnProgressChange { get; set; }

    /// <summary>Estado elegido en el selector. El padre persiste y devuelve el libro.</summary>
    [Parameter] public EventCallback<ReadingStatus> OnStatusChange { get; set; }

    /// <summary>El lector confirmó que terminó el libro. El padre persiste y recarga.</summary>
    [Parameter] public EventCallback OnComplete { get; set; }

    private ConfirmDialog? _confirm;

    private void AskComplete() =>
        _confirm?.Show(
            "Marcar como completado",
            "Se completarán todas las páginas, el libro pasará a «Leído» y se registrará la fecha de fin. ¿Continuar?",
            "Completar", "Cancelar",
            () => OnComplete.InvokeAsync(),
            destructive: false);

    private bool Editing { get; set; }

    private string ArticleStyle => (AccentStyle ?? string.Empty) + (CoverStyle ?? string.Empty);

    private string? AccentStyle
    {
        get
        {
            if (Book is null) return null;
            var (onLight, strong, onDark) = SpinePalette.AccentsFor(Book.SpineColor, Book.CategoryName);
            return $"--accent-light: {onLight}; --accent-light-strong: {strong}; --accent-dark: {onDark}; ";
        }
    }

    private Task ChangeStatus(ChangeEventArgs e) =>
        Enum.TryParse<ReadingStatus>(e.Value?.ToString(), out var status) && status != Book?.Status
            ? OnStatusChange.InvokeAsync(status)
            : Task.CompletedTask;

    private int _pageInputEpoch;

    private bool HasCover => !string.IsNullOrWhiteSpace(Book?.CoverPath);

    /// <summary>Clase de tarjeta clara: sólo cuando la portada actúa de fondo.</summary>
    private string? PanelClass => HasCover ? "catalogue-panel" : null;

    /// <summary>
    /// Portada como fondo de la ficha, con el velo negro al 50% como primera capa.
    /// Ambas capas quedan fijas al borde del contenedor: el contenido hace scroll, la imagen no.
    /// </summary>
    private string? CoverStyle => HasCover
        ? $"background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('{CssUrl(Book!.CoverPath!)}');"
        : null;

    private static string CssUrl(string path) => path
        .Replace("\\", "%5C")
        .Replace("'", "%27")
        .Replace("\"", "%22")
        .Replace("(", "%28")
        .Replace(")", "%29")
        .Replace("\n", string.Empty)
        .Replace("\r", string.Empty);

    protected override void OnParametersSet()
    {
        if (Book is not null) Editing = false;
    }

    private Task HandleSave(BookFormModel model) => OnSave.InvokeAsync(model);

    private int ProgressPct(int total)
    {
        if (Book?.CurrentPage is not { } current || total <= 0) return 0;
        return Math.Clamp((int)Math.Round(100.0 * current / total), 0, 100);
    }

    private int CurrentPage => Book?.CurrentPage ?? 0;

    /// <summary>Sin total declarado el lector sigue pudiendo anotar la página; el tope es el de validación.</summary>
    private int MaxPage => Book?.PageCount ?? BookFormModel.MaxTrackablePage;

    private bool CanRewind => CurrentPage > 0;

    private bool CanAdvance => CurrentPage < MaxPage;

    private string TotalLabel => Book?.PageCount is { } total ? $"/ {total}" : "págs.";

    private string PageInputLabel => Book?.PageCount is { } total
        ? $"Página actual de {total}"
        : "Página actual";

    private Task StepPage(int delta) => CommitPage(CurrentPage + delta);

    private Task SetPage(ChangeEventArgs e) =>
        CommitPage(int.TryParse(e.Value?.ToString(), out var page) ? page : CurrentPage);

    private Task CommitPage(int page)
    {
        // Recortamos aquí para que la ficha nunca muestre un número que el
        // servicio va a rechazar; el servicio vuelve a recortar por su cuenta.
        var target = Math.Clamp(page, 0, MaxPage);
        _pageInputEpoch++;
        return target == CurrentPage ? Task.CompletedTask : OnProgressChange.InvokeAsync(target);
    }

    private static string StatusLabel(ReadingStatus s) => s switch
    {
        ReadingStatus.ToRead => "Por leer",
        ReadingStatus.Reading => "Leyendo",
        ReadingStatus.Read => "Leído",
        _ => s.ToString()
    };
}
